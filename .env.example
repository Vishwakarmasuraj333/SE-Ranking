# SE Ranking API Credentials
SE_RANKING_API_TOKEN=your_se_ranking_api_token_here
SE_RANKING_API_BASE_URL=https://api.seranking.com/v1

# Demo Work Office Login Credentials (Instant sign-in for development & Vercel)
DEMO_WORK_EMAIL="admin@seranking.com"
DEMO_PASSWORD="AdminPassword123#"
DEMO_PROJECT_DOMAIN="https://www.workcomposer.com/"

# Database Configuration (SQLite default for easy local zero-friction setup, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/se_ranking_studio?schema=public"

# SEO Provider Mode: "real" or "mock"
# Default is "real", set to "mock" for offline development or sandbox testing
SEO_PROVIDER_MODE=mock

