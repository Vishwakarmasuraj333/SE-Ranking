# Database Configuration (SQLite dev.db zero-friction local persistence)
DATABASE_URL="file:./prisma/dev.db"

# SEO Provider Mode: "real" or "mock"
SEO_PROVIDER_MODE=real

# SE Ranking Official Data API Credentials
SE_RANKING_API_TOKEN=e4b7c89f2a1d4e6c8b9a0f1e2d3c4b5a
SE_RANKING_API_BASE_URL=https://api.seranking.com/v1

# Google OAuth 2.0 Credentials (for instant sign-in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email SMTP Server Configuration (for alerts, reports & verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SE Ranking Studio <no-reply@seranking.com>"

# Security & Captcha Protection (Cloudflare Turnstile / Google ReCAPTCHA v3)
